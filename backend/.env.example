SERVER_ADDR=:8080
DB_DSN=root:password@tcp(127.0.0.1:3306)/silo?charset=utf8mb4&parseTime=True&loc=Local
# HTTP RPC endpoint — used by eth_getLogs polling (backfill channel)
HTTP_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# WebSocket endpoint — used by SubscribeFilterLogs (real-time channel)
WS_RPC_URL=wss://ethereum-sepolia-rpc.publicnode.com
POOL_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
START_BLOCK=0
# Kafka brokers (comma-separated)
KAFKA_BROKERS=localhost:9092
# Topic prefix → generates: silo.deposit, silo.withdraw, silo.borrow, silo.repay, silo.liquidate
KAFKA_TOPIC_PREFIX=silo
# Blocks to wait before considering an event safe for DB write
SAFE_CONFIRMATIONS=12

# ── Redis (position cache + TWAP window + breaker state) ──
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Liquidation ──
# TWAP rolling window
TWAP_WINDOW=30m
TWAP_GRANULARITY=30s
# Spot vs TWAP deviation thresholds
LIQ_NORMAL_MAX_DEVIATION=0.05   # 5% → normal mode
LIQ_EXTREME_MAX_DEVIATION=0.15  # 15% → circuit breaker trips
# Circuit breaker
LIQ_CB_COOLDOWN=5m
LIQ_CB_MAX_LIQ=3               # max liquidations per batch in extreme mode
# Rate limiting
LIQ_NORMAL_MAX_BATCH=20
LIQ_SCAN_INTERVAL=15s

# ── Chainlink price feeds (tokenAddr → aggregatorAddr, JSON map) ──
# Maps each pool asset to its Chainlink AggregatorV3 contract.
# Example: {"0xETH_TOKEN":"0xETH_USD_AGGREGATOR","0xUSDC_TOKEN":"0xUSDC_USD_AGGREGATOR"}
PRICE_FEED_ADDRS={}

# ── Liquidation executor (optional — set to enable on-chain liquidation) ──
LIQ_EXECUTOR_KEY=               # private key for liquidation tx signing

# ── MEV protection (Flashbots / MEV-boost relay) ──
LIQ_FLASHBOTS_RELAY_URL=        # e.g. https://relay.flashbots.net — private tx submission

# ── Profitability ──
LIQ_MIN_PROFIT_MARGIN=1.1       # minimum profit ratio: reward / gasCost (1.1 = 10% profit)

# ── Price staleness ──
LIQ_PRICE_STALE_SECONDS=3600    # max age (seconds) of oracle price before considered stale
